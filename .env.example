# Garmin Connect web > Settings > Personal API Key > Create Key
# This is a PERSONAL API KEY, not your Garmin password.
GARMIN_PERSONAL_API_KEY=
# Or keep the key in a private file instead of .env:
# GARMIN_PERSONAL_API_KEY_FILE=/Users/you/.config/garmin/connect-personal-api-key

# Create a Strava API application at https://www.strava.com/settings/api
# Set authorization callback domain to localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional local state folder (use a different folder for each athlete)
# G2S_HOME=/Users/you/.garmin-api-to-strava
# Official API defaults; override only if Garmin/Strava change their hostnames
# GARMIN_PERSONAL_API_BASE_URL=https://personal.connectapi.garmin.com
# STRAVA_API_BASE=https://www.strava.com/api/v3

# Optional: minimum delay between Garmin API requests in milliseconds (default 2000)
# GARMIN_MIN_INTERVAL_MS=3000
