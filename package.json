{
  "name": "garmin-personal-api-to-strava",
  "version": "0.4.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Local-first, resumable Garmin Personal API migration and Strava duplicate auditing",
  "bin": {
    "g2s": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "license": "MIT"
}
